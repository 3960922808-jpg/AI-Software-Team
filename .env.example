# 开发环境可选配置。正式用户应优先在桌面软件“模型与 API”中保存密钥。
AI_TEAM_PROVIDER=openai
AI_TEAM_BASE_URL=https://api.openai.com/v1
AI_TEAM_MODEL=gpt-4.1-mini
AI_TEAM_API_KEY=replace-with-your-api-key
AI_TEAM_ROUTING_MODE=balanced

# 窗口与启动页调试配置。
AI_TEAM_WINDOW_WIDTH=1380
AI_TEAM_WINDOW_HEIGHT=860
AI_TEAM_STARTUP_MIN_MS=2200
