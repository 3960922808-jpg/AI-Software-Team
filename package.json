{
  "name": "ai-software-team",
  "version": "0.8.0",
  "description": "Windows desktop multi-agent software development workspace",
  "main": "electron/main.js",
  "author": "AI Software Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win nsis zip",
    "pack:windows": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aisoftwareteam.desktop",
    "productName": "AI Software Team",
    "asar": true,
    "directories": {
      "output": "release-v0.8"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
      ,"artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Software Team"
    }
  }
}
